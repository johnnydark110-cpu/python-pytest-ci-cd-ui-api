{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://automation.local/schemas/order_list.json",
    "title": "OrderList",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "total",
        "page",
        "page_size",
        "items"
    ],
    "properties": {
        "total": {
            "type": "integer",
            "minimum": 0
        },
        "page": {
            "type": "integer",
            "minimum": 1
        },
        "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
        },
        "items": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/order"
            }
        }
    },
    "$defs": {
        "order": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "title",
                "amount",
                "status",
                "created_at"
            ],
            "properties": {
                "id": {
                    "type": "integer",
                    "minimum": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                },
                "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "pending",
                        "paid",
                        "shipped",
                        "done",
                        "canceled"
                    ]
                },
                "created_at": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}